DEBUG=True
ALLOW_DEMO_DATA=True
SECRET_KEY=django-development-secret-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Tehran

# Local/Docker PostgreSQL settings. These are used when DATABASE_URL is empty.
POSTGRES_DB=doctor_appointment
POSTGRES_USER=doctor_app
POSTGRES_PASSWORD=doctor_app_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional cloud/preview database URLs. Keep these empty for local PostgreSQL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

CACHE_URL=locmemcache://

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@doctor-appointment.local
