SECRET_KEY=replace-with-a-unique-random-secret-containing-at-least-50-characters
DEBUG=False
ALLOW_DEMO_DATA=False
ALLOWED_HOSTS=appointments.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://appointments.example.com
TIME_ZONE=Asia/Tehran

POSTGRES_DB=doctor_appointment
POSTGRES_USER=doctor_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CACHE_URL=redis://cache:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@appointments.example.com

PROXY_BIND_ADDRESS=127.0.0.1
PROXY_HTTP_PORT=8080

RUN_MIGRATIONS=false
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
